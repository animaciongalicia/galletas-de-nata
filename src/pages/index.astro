---
import Base from '../layouts/Base.astro';
import Figura from '../components/Figura.astro';
import Ilustracion from '../components/Ilustracion.astro';
import Rejilla from '../components/Rejilla.astro';
import Vacio from '../components/Vacio.astro';
import { LISTA_SECCIONES } from '../data/secciones';
import { SITIO } from '../data/sitio';
import { getPiezas, urlPaginaVisible, url } from '../lib/contenido';
import portada from '../assets/provisional/portada.jpg';

const piezas = await getPiezas();
const destacadas = [...piezas.filter((p) => p.data.destacado), ...piezas.filter((p) => !p.data.destacado)].slice(0, 6);
const sobre = await urlPaginaVisible('sobre-el-proyecto');
const guiaNata = piezas.find((p) => p.id === 'autentica-nata-de-vaca');
const cuenta = (id: string) => piezas.filter((p) => p.data.seccion === id).length;

// Sustituye por una fotografía propia: importa el archivo de src/assets/fotos/ y pon provisional: false.
const imagenPortada = {
  src: portada,
  alt: 'Galletas de nata redondas sobre un fondo claro',
  provisional: true,
};

const site = Astro.site!;
const esquemas = [
  { '@type': 'WebSite', name: SITIO.nombre, url: site.href, inLanguage: SITIO.idioma, description: SITIO.lema },
];
---

<Base
  titulo="Galletas de Nata: recetas caseras, postres y todo sobre la nata"
  tituloCompleto
  descripcion="Portal sobre la galleta de nata gallega: qué la caracteriza, recetas caseras probadas, postres con galletas y cómo influye la nata en el resultado."
  esquemas={esquemas}
>
  <section class="envoltorio heroe">
    <div class="heroe-texto">
      <p class="antetitulo">Galicia · horno · nata</p>
      <h1>Galletas de <em>Nata</em></h1>
      <p class="entradilla">
        Las galletas de nata gallegas de siempre: cómo se hacían en casa, qué nata necesitan y todo lo que puedes
        preparar con ellas. Explicado por un antiguo fabricante de galletas de nata.
      </p>
      <div class="acciones">
        <a class="boton" href="/recetas/">Ver recetas</a>
        <a class="boton boton--claro" href="/postres-con-galletas/">Descubrir postres</a>
        <a class="boton boton--claro" href="/nata-y-elaboracion/">Aprender sobre la nata</a>
      </div>
    </div>
    <div class="heroe-imagen">
      <Figura imagen={imagenPortada} prioridad proporcion="4 / 3" semilla="portada-galletas" densidad={5} tamanos="(max-width: 62rem) 100vw, 40rem" anchos={[480, 800, 1200, 1600]} />
    </div>
  </section>

  <section class="envoltorio datos" aria-labelledby="datos-titulo">
    <h2 id="datos-titulo" class="sr-only">La galleta de nata en tres datos</h2>
    <dl>
      <div>
        <dt>3</dt>
        <dd><strong>ingredientes</strong> en la receta tradicional: nata, azúcar y harina.</dd>
      </div>
      <div>
        <dt>70-80 %</dt>
        <dd>de <strong>materia grasa</strong> en la nata que dio la galleta de siempre en las pruebas del proyecto.</dd>
      </div>
      <div>
        <dt>≈ 50 %</dt>
        <dd>de <strong>grasa en la galleta horneada</strong> con esa nata, frente al ≈ 20 % con una nata del 35 %.</dd>
      </div>
    </dl>
    {guiaNata && <p class="datos-mas"><a href={url(guiaNata.id)}>Por qué la nata lo cambia todo →</a></p>}
  </section>

  <section class="envoltorio bloque" aria-labelledby="destacado-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Guías esenciales</p>
      <h2 id="destacado-titulo">Para empezar</h2>
    </div>
    {destacadas.length > 0 ? <Rejilla piezas={destacadas} /> : <Vacio mensaje="Los primeros contenidos se publicarán muy pronto." />}
    <p class="ver-todo"><a href="/buscar/">Ver todos los contenidos →</a></p>
  </section>

  <section class="envoltorio bloque" aria-labelledby="secciones-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Explora</p>
      <h2 id="secciones-titulo">Secciones</h2>
    </div>
    <ul class="secciones">
      {
        LISTA_SECCIONES.map((s, i) => (
          <li>
            <a href={`/${s.slug}/`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="nombre">{s.nombre}</span>
              <span class="desc">{s.descripcion}</span>
              <span class="cuenta">
                {cuenta(s.id) > 0 ? `${cuenta(s.id)} ${cuenta(s.id) === 1 ? 'contenido' : 'contenidos'}` : 'Próximamente'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="envoltorio bloque proyecto" aria-labelledby="proyecto-titulo">
    <div class="proyecto-texto">
      <p class="antetitulo">El proyecto</p>
      <h2 id="proyecto-titulo">Hecho por alguien que las fabricó</h2>
      <p>
        Detrás de este portal hay un antiguo fabricante de galletas de nata que lleva desde 2012 probando
        ingredientes, procesos y resultados. Aquí comparte lo que funciona en una cocina normal: recetas caseras
        completas, explicaciones claras y solo resultados que se han comprobado.
      </p>
      {sobre && <a class="boton boton--claro" href={sobre}>Conoce el proyecto</a>}
    </div>
    <div class="proyecto-ilus">
      <Ilustracion semilla="proyecto" tono="oliva" proporcion="1 / 1" densidad={3} />
    </div>
  </section>
</Base>

<style>
  .heroe {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--e-5);
    align-items: center;
    padding: var(--e-5) 0 var(--e-4);
  }
  .heroe h1 {
    font-size: clamp(3rem, 1.6rem + 5.2vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: var(--e-3);
  }
  .heroe h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--tostado);
  }
  .heroe .entradilla {
    max-width: 34rem;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1);
    margin-top: var(--e-4);
  }
  .heroe-imagen :global(.ilustracion),
  .heroe-imagen :global(img) {
    border-radius: calc(var(--radio) * 2);
    box-shadow: var(--sombra);
  }
  @media (max-width: 62rem) {
    .heroe {
      grid-template-columns: 1fr;
      gap: var(--e-4);
      padding-top: var(--e-4);
    }
    .heroe-imagen :global(.ilustracion) {
      aspect-ratio: 16 / 9 !important;
    }
  }

  .datos {
    margin-top: var(--e-2);
    padding: var(--e-4) 0;
    border-block: 1px solid var(--linea);
  }
  .datos dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e-4);
    margin: 0;
  }
  .datos dt {
    font-family: var(--f-titulo);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    color: var(--oliva-hondo);
    letter-spacing: -0.02em;
    margin-bottom: var(--e-1);
  }
  .datos dd {
    margin: 0;
    color: var(--tinta-suave);
    font-size: var(--t-s);
    max-width: 18rem;
  }
  .datos dd strong {
    color: var(--tinta);
  }
  .datos-mas {
    margin: var(--e-3) 0 0;
    font-weight: 600;
  }
  @media (max-width: 48rem) {
    .datos dl {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
  }

  .bloque {
    margin-top: var(--e-5);
  }
  .bloque-cabecera {
    margin-bottom: var(--e-3);
  }
  .bloque-cabecera h2 {
    margin: 0;
  }
  .ver-todo {
    margin-top: var(--e-3);
    font-weight: 600;
  }
  .secciones {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--e-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .secciones a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: var(--e-3);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    color: var(--tinta);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .secciones a:hover {
    border-color: var(--galleta);
    box-shadow: var(--sombra);
    transform: translateY(-2px);
  }
  .num {
    font-family: var(--f-titulo);
    font-size: var(--t-s);
    color: var(--galleta);
    font-weight: 600;
  }
  .nombre {
    font-family: var(--f-titulo);
    font-size: var(--t-l);
    font-weight: 600;
    line-height: 1.2;
  }
  .desc {
    font-size: var(--t-s);
    color: var(--tinta-suave);
  }
  .cuenta {
    margin-top: auto;
    padding-top: var(--e-1);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--oliva);
  }
  .proyecto {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--e-4);
    align-items: center;
    background: var(--oliva-claro);
    border-radius: calc(var(--radio) * 2);
    padding: var(--e-4);
  }
  .proyecto h2 {
    margin-top: 0;
  }
  .proyecto-ilus {
    max-width: 16rem;
    justify-self: end;
    width: 100%;
  }
  @media (max-width: 48rem) {
    .proyecto {
      grid-template-columns: 1fr;
      padding: var(--e-3);
    }
    .proyecto-ilus {
      display: none;
    }
  }
</style>
