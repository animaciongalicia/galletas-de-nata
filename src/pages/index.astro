---
import Base from '../layouts/Base.astro';
import Figura from '../components/Figura.astro';
import Rejilla from '../components/Rejilla.astro';
import Vacio from '../components/Vacio.astro';
import HistoriasCasa from '../components/HistoriasCasa.astro';
import { SITIO } from '../data/sitio';
import { getPiezas, url } from '../lib/contenido';
import fotoApertura from '../assets/fotos/ordeno-de-la-vaca-y-ninos-bebiendo-leche.jpg';
import fotoVacas from '../assets/fotos/vacas-frisonas-en-un-prado-gallego.jpg';
import fotoLeche from '../assets/fotos/leche-recien-ordenada-en-el-fuego.jpg';
import fotoCapa from '../assets/fotos/capa-de-nata-sobre-la-leche-hervida.jpg';
import fotoGuardar from '../assets/fotos/sacar-la-nata-de-la-leche-cocida.jpg';
import fotoHorno from '../assets/fotos/galletas-de-nata-en-la-rejilla.jpg';

const piezas = await getPiezas();
const destacadas = [...piezas.filter((p) => p.data.destacado), ...piezas.filter((p) => !p.data.destacado)].slice(0, 8);
const historia = piezas.find((p) => p.id === 'como-se-hacian-las-galletas-de-nata');
const guiaNata = piezas.find((p) => p.id === 'autentica-nata-de-vaca');

const pasos = [
  {
    foto: fotoLeche,
    alt: 'Cazos con leche recién ordeñada calentándose en la cocina',
    titulo: 'La leche',
    texto: 'Se ordeñaba la vaca y la leche se hervía. Así duraba más.',
  },
  {
    foto: fotoCapa,
    alt: 'Capa de nata sobre la leche hervida, separada con un cuchillo',
    titulo: 'La capa de nata',
    texto: 'Al enfriar, en la superficie se formaba una capa de nata. Se recogía con cuidado y se apartaba.',
  },
  {
    foto: fotoGuardar,
    alt: 'Nata recogida con un cucharón de la leche cocida',
    titulo: 'Juntar nata',
    texto: 'Se iba guardando una semana o diez días, hasta reunir 200, 500 gramos o más.',
  },
  {
    foto: fotoHorno,
    alt: 'Galletas de nata recién horneadas enfriándose en una rejilla',
    titulo: 'Al horno',
    texto: 'Con azúcar y harina, al horno. Cada casa, su punto: unas más duras, otras más tiernas.',
  },
];

const site = Astro.site!;
const esquemas = [
  { '@type': 'WebSite', name: SITIO.nombre, url: site.href, inLanguage: SITIO.idioma, description: SITIO.lema },
];
---

<Base
  titulo="Galletas de Nata: historia, recetas caseras y todo sobre la nata"
  tituloCompleto
  descripcion="La galleta de nata gallega: cómo se hacía en casa con la nata de la leche hervida, qué nata necesita y recetas caseras para volver a hacerla."
  esquemas={esquemas}
>
  <!-- 1. Apertura -->
  <section class="envoltorio apertura">
    <div class="apertura-texto">
      <p class="antetitulo">La galleta de nata gallega</p>
      <h1>No se compraban. <em>Salían de la leche de casa.</em></h1>
      <p class="entradilla">
        Leche recién ordeñada, nata guardada día a día y una lata de galletas para los niños. Su historia, la nata que
        necesitan y cómo volver a hacerlas.
      </p>
      <div class="acciones">
        {historia && <a class="boton" href={url(historia.id)}>Lee la historia</a>}
        <a class="enlace-flecha" href="/recetas/">Ver recetas →</a>
      </div>
    </div>
    <div class="apertura-foto">
      <Figura
        imagen={{ src: fotoApertura, alt: 'Foto antigua en blanco y negro: una mujer ordeña una vaca mientras unos niños beben leche', provisional: false }}
        prioridad
        proporcion="4 / 3"
        tamanos="(max-width: 62rem) 100vw, 30rem"
        anchos={[480, 676]}
      />
    </div>
  </section>

  <!-- 2. Tierra de vacas -->
  <section class="envoltorio banda banda--crema tierra" aria-labelledby="tierra-titulo">
    <div class="tierra-foto">
      <Figura imagen={{ src: fotoVacas, alt: 'Vacas frisonas pastando en un prado gallego', provisional: false }} proporcion="3 / 2" tamanos="(max-width: 62rem) 100vw, 30rem" anchos={[480, 750]} />
    </div>
    <div class="tierra-texto">
      <p class="antetitulo">Galicia</p>
      <h2 id="tierra-titulo">Tierra de vacas y de leche</h2>
      <p>
        En una casa con vacas siempre había leche que hervir y nata que aprovechar. En casi toda la Galicia rural, y
        mucho en la comarca de Ferrol, las galletas de nata formaban parte de la infancia.
      </p>
      <dl class="cifras">
        <div>
          <dt>≈&nbsp;41&nbsp;%</dt>
          <dd>de la leche de vaca de España sale hoy de Galicia.</dd>
        </div>
        <div>
          <dt>56&nbsp;%</dt>
          <dd>de las explotaciones lecheras del país están aquí.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 3. Del cazo a la lata -->
  <section class="envoltorio bloque proceso" aria-labelledby="proceso-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Cómo se hacían</p>
      <h2 id="proceso-titulo">Del cazo a la lata</h2>
    </div>
    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li>
            <Figura imagen={{ src: p.foto, alt: p.alt, provisional: false }} proporcion="4 / 5" anchos={[320, 480, 640]} tamanos="(max-width: 40rem) 100vw, (max-width: 62rem) 50vw, 17rem" />
            <p class="paso-num">{['I', 'II', 'III', 'IV'][i]}</p>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
    {historia && <p class="mas"><a class="enlace-flecha" href={url(historia.id)}>La historia completa →</a></p>}
  </section>

  <!-- 4. Aprovechamiento -->
  <section class="envoltorio banda banda--tinta aprovechamiento" aria-labelledby="aprov-titulo">
    <div>
      <p class="antetitulo">Aprovechamiento</p>
      <h2 id="aprov-titulo" class="cita">
        Con lo que sobraba de la leche, las abuelas hacían <em>el dulce de los niños</em>.
      </h2>
    </div>
    <div class="aprov-texto">
      <p class="antetitulo">Por qué se perdió</p>
      <p>
        En 1952 un decreto ordenó crear centrales lecheras en las ciudades. En las décadas siguientes, la leche
        pasteurizada y envasada llegó a casi todas las casas.
      </p>
      <p>Ya no hacía falta hervir la leche. Y sin leche hervida, no había capa de nata que guardar.</p>
    </div>
  </section>

  <!-- 5. Dos natas, dos galletas -->
  <section class="envoltorio bloque natas" aria-labelledby="natas-titulo">
    <div class="bloque-cabecera natas-cabecera">
      <div>
        <p class="antetitulo">La nata</p>
        <h2 id="natas-titulo">Dos natas, dos galletas</h2>
      </div>
      <p class="natas-intro">
        La receta lleva tres ingredientes: nata, azúcar y harina. Toda la grasa sale de la nata, así que{' '}
        <strong>la nata decide la galleta</strong>.
      </p>
    </div>
    <div class="comparacion">
      <article>
        <p class="antetitulo">La nata de antes</p>
        <h3>Muy grasa, desnatada en la lechería</h3>
        <dl>
          <div><dt>70-80&nbsp;%</dt><dd>de materia grasa en la nata</dd></div>
          <div><dt>≈&nbsp;50&nbsp;%</dt><dd>de grasa en la galleta horneada</dd></div>
        </dl>
        <p class="resultado">Sabe a nata. Es la galleta de siempre.</p>
      </article>
      <article>
        <p class="antetitulo">La nata de hoy</p>
        <h3>La de montar, en brik</h3>
        <dl>
          <div><dt>35&nbsp;%</dt><dd>de materia grasa en la nata</dd></div>
          <div><dt>≈&nbsp;20&nbsp;%</dt><dd>de grasa en la galleta horneada</dd></div>
        </dl>
        <p class="resultado">Sale rica, pero se parece a una galleta de mantequilla.</p>
      </article>
    </div>
    <p class="nota">Porcentajes en masa. La grasa de la galleta es la que quedó en las pruebas hechas para esta web.</p>
    {guiaNata && <p class="mas"><a class="enlace-flecha" href={url(guiaNata.id)}>Por qué la nata lo cambia todo →</a></p>}
  </section>

  <!-- 6. Hazlas tú -->
  <section class="envoltorio banda banda--crema guias" aria-labelledby="guias-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Hazlas tú</p>
      <h2 id="guias-titulo">Recetas, nata y postres</h2>
    </div>
    {destacadas.length > 0 ? <Rejilla piezas={destacadas} /> : <Vacio mensaje="Los primeros contenidos se publicarán muy pronto." />}
    <p class="mas"><a class="enlace-flecha" href="/buscar/">Ver todos los contenidos →</a></p>
  </section>

  <!-- 7. Historias de casa -->
  <HistoriasCasa />
</Base>

<style>
  /* 1. Apertura */
  .apertura {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--e-5);
    align-items: center;
    padding-block: var(--e-5);
  }
  .apertura h1 {
    font-size: clamp(2.6rem, 1.4rem + 4.2vw, 5rem);
    font-weight: 350;
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin: 0 0 var(--e-3);
  }
  .apertura h1 em {
    display: block;
    font-style: italic;
    font-weight: 300;
    color: var(--tostado);
  }
  .apertura .entradilla {
    margin: 0 0 var(--e-4);
  }
  .apertura-foto :global(img) {
    box-shadow: 18px 18px 0 var(--marfil-hondo);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
  }

  /* Bloques comunes */
  .bloque {
    padding-block: var(--e-5);
  }
  .bloque-cabecera {
    margin-bottom: var(--e-4);
  }
  .bloque-cabecera h2,
  .tierra h2 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 400;
  }
  .mas {
    margin: var(--e-4) 0 0;
  }

  /* 2. Tierra de vacas */
  .tierra {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--e-5);
    align-items: center;
    padding-block: var(--e-5);
  }
  .tierra-texto > p:not(.antetitulo) {
    font-family: var(--f-titulo);
    font-size: 1.25rem;
    font-weight: 350;
    line-height: 1.55;
    margin: var(--e-3) 0;
  }
  .cifras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-3);
    margin: 0;
    padding-top: var(--e-3);
    border-top: 1px solid var(--tinta);
  }
  .cifras dt {
    font-family: var(--f-titulo);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--oliva);
    margin-bottom: var(--e-1);
  }
  .cifras dd {
    margin: 0;
    font-size: var(--t-s);
    color: var(--tinta-suave);
  }

  /* 3. Del cazo a la lata */
  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--e-3);
    counter-reset: paso;
  }
  .paso-num {
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--tostado);
    margin: var(--e-2) 0 0.2rem;
    padding-top: var(--e-1);
    border-top: 1px solid var(--tinta);
  }
  .pasos h3 {
    font-size: 1.4rem;
    font-weight: 450;
    margin: 0 0 var(--e-1);
  }
  .pasos li > p:last-child {
    font-size: var(--t-s);
    color: var(--tinta-suave);
    margin: 0;
  }

  /* 4. Aprovechamiento */
  .aprovechamiento {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--e-5);
    align-items: end;
    padding-block: calc(var(--e-5) * 1.3);
  }
  .cita {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem);
    font-weight: 300;
    line-height: 1.12;
    margin: 0;
    color: var(--marfil);
  }
  .cita em {
    font-style: italic;
    color: var(--galleta-claro);
  }
  .aprov-texto {
    border-left: 1px solid rgb(246 243 236 / 25%);
    padding-left: var(--e-3);
    color: rgb(246 243 236 / 82%);
    font-size: var(--t-s);
  }
  .aprov-texto p:last-child {
    margin-bottom: 0;
  }

  /* 5. Dos natas, dos galletas */
  .natas-cabecera {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e-4);
    align-items: end;
  }
  .natas-intro {
    margin: 0;
    font-family: var(--f-titulo);
    font-size: 1.25rem;
    font-weight: 350;
    line-height: 1.5;
    color: var(--tinta-suave);
  }
  .comparacion {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--tinta);
  }
  .comparacion article {
    padding: var(--e-4) var(--e-4) var(--e-3) 0;
  }
  .comparacion article + article {
    padding-left: var(--e-4);
    border-left: 1px solid var(--linea);
  }
  .comparacion h3 {
    font-size: 1.45rem;
    font-weight: 450;
    margin: 0 0 var(--e-3);
  }
  .comparacion dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-3);
    margin: 0 0 var(--e-3);
  }
  .comparacion dt {
    font-family: var(--f-titulo);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: var(--e-1);
  }
  .comparacion article:first-child dt {
    color: var(--tostado);
  }
  .comparacion dd {
    margin: 0;
    font-size: var(--t-s);
    color: var(--tinta-suave);
  }
  .resultado {
    margin: 0;
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.2rem;
  }
  .nota {
    margin: var(--e-2) 0 0;
    font-size: var(--t-xs);
    color: var(--tinta-suave);
  }

  /* 6. Hazlas tú */
  .guias {
    padding-block: var(--e-5);
  }

  @media (max-width: 62rem) {
    .apertura,
    .tierra,
    .aprovechamiento,
    .natas-cabecera {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
    .apertura {
      padding-top: var(--e-4);
    }
    .apertura-foto,
    .tierra-foto {
      max-width: 34rem;
    }
    .apertura-foto :global(img) {
      box-shadow: 10px 10px 0 var(--marfil-hondo);
    }
    .pasos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--e-4);
    }
  }
  @media (max-width: 40rem) {
    .comparacion {
      grid-template-columns: 1fr;
    }
    /* Pasos en filas: miniatura a la izquierda, texto a la derecha. */
    .pasos {
      grid-template-columns: 1fr;
      row-gap: var(--e-3);
    }
    .pasos li {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: var(--e-2);
      align-items: start;
    }
    .pasos li > :global(.figura) {
      grid-row: span 3;
    }
    .paso-num {
      margin-top: 0;
    }
    .comparacion article,
    .comparacion article + article {
      padding: var(--e-3) 0;
      border-left: 0;
    }
    .comparacion article + article {
      border-top: 1px solid var(--linea);
    }
  }
</style>
