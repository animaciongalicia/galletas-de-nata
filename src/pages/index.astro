---
import Base from '../layouts/Base.astro';
import Figura from '../components/Figura.astro';
import Rejilla from '../components/Rejilla.astro';
import Vacio from '../components/Vacio.astro';
import { LISTA_SECCIONES } from '../data/secciones';
import { SITIO } from '../data/sitio';
import { getPiezas, urlPaginaVisible, url } from '../lib/contenido';
import portada from '../assets/provisional/portada.jpg';

const piezas = await getPiezas();
const destacadas = [...piezas.filter((p) => p.data.destacado), ...piezas.filter((p) => !p.data.destacado)].slice(0, 6);
const sobre = await urlPaginaVisible('sobre-el-proyecto');
const guiaNata = piezas.find((p) => p.id === 'autentica-nata-de-vaca');
const cuenta = (id: string) => piezas.filter((p) => p.data.seccion === id).length;

// Sustituye por una fotografía propia: importa el archivo de src/assets/fotos/ y pon provisional: false.
const imagenPortada = {
  src: portada,
  alt: 'Galletas de nata redondas sobre un fondo claro',
  provisional: true,
};

const site = Astro.site!;
const esquemas = [
  { '@type': 'WebSite', name: SITIO.nombre, url: site.href, inLanguage: SITIO.idioma, description: SITIO.lema },
];
---

<Base
  titulo="Galletas de Nata: recetas caseras, postres y todo sobre la nata"
  tituloCompleto
  descripcion="Portal sobre la galleta de nata gallega: qué la caracteriza, recetas caseras probadas, postres con galletas y cómo influye la nata en el resultado."
  esquemas={esquemas}
>
  <section class="envoltorio heroe">
    <p class="antetitulo">Historia, recetas y técnica</p>
    <h1>La galleta <em>de nata</em> gallega</h1>
    <div class="heroe-pie">
      <p class="entradilla">
        Cómo se hacía en casa, qué nata necesita y todo lo que puedes preparar con ella. Explicado por un antiguo
        fabricante de galletas de nata.
      </p>
      <div class="acciones">
        <a class="boton" href="/recetas/">Ver recetas</a>
        <a class="enlace-flecha" href="/nata-y-elaboracion/">Entender la nata →</a>
      </div>
    </div>
  </section>

  {!imagenPortada.provisional && (
    <div class="envoltorio heroe-imagen">
      <Figura imagen={imagenPortada} prioridad proporcion="21 / 9" tamanos="(max-width: 72rem) 100vw, 72rem" anchos={[640, 1000, 1400, 2000]} />
    </div>
  )}

  <section class="envoltorio datos" aria-labelledby="datos-titulo">
    <h2 id="datos-titulo" class="sr-only">La galleta de nata en tres datos</h2>
    <dl>
      <div>
        <dt>3</dt>
        <dd><strong>ingredientes</strong> en la receta tradicional: nata, azúcar y harina.</dd>
      </div>
      <div>
        <dt>70-80&nbsp;%</dt>
        <dd>de <strong>materia grasa</strong> en la nata que dio la galleta de siempre en las pruebas del proyecto.</dd>
      </div>
      <div>
        <dt>≈&nbsp;50&nbsp;%</dt>
        <dd>de <strong>grasa en la galleta horneada</strong> con esa nata, frente al ≈&nbsp;20&nbsp;% con una nata del 35&nbsp;%.</dd>
      </div>
    </dl>
    {guiaNata && <p class="datos-mas"><a class="enlace-flecha" href={url(guiaNata.id)}>Por qué la nata lo cambia todo →</a></p>}
  </section>

  <section class="envoltorio bloque" aria-labelledby="destacado-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Guías esenciales</p>
      <h2 id="destacado-titulo">Para empezar</h2>
    </div>
    {destacadas.length > 0 ? <Rejilla piezas={destacadas} /> : <Vacio mensaje="Los primeros contenidos se publicarán muy pronto." />}
    <p class="ver-todo"><a class="enlace-flecha" href="/buscar/">Ver todos los contenidos →</a></p>
  </section>

  <section class="envoltorio bloque" aria-labelledby="secciones-titulo">
    <div class="bloque-cabecera">
      <p class="antetitulo">Índice</p>
      <h2 id="secciones-titulo">Secciones</h2>
    </div>
    <ul class="secciones">
      {
        LISTA_SECCIONES.map((s, i) => (
          <li>
            <a href={`/${s.slug}/`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="nombre">{s.nombre}</span>
              <span class="desc">{s.descripcion}</span>
              <span class="cuenta">
                {cuenta(s.id) > 0 ? `${cuenta(s.id)} ${cuenta(s.id) === 1 ? 'contenido' : 'contenidos'}` : 'Próximamente'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="envoltorio bloque proyecto" aria-labelledby="proyecto-titulo">
    <div>
      <p class="antetitulo">El proyecto</p>
      <h2 id="proyecto-titulo">Hecho por alguien que las fabricó</h2>
    </div>
    <div class="proyecto-texto">
      <p>
        Detrás de este portal hay un antiguo fabricante de galletas de nata que lleva desde 2012 probando
        ingredientes, procesos y resultados. Aquí comparte lo que funciona en una cocina normal: recetas caseras
        completas, explicaciones claras y solo resultados que se han comprobado.
      </p>
      {sobre && <a class="enlace-flecha" href={sobre}>Conoce el proyecto →</a>}
    </div>
  </section>
</Base>

<style>
  .heroe {
    padding: var(--e-5) 0 var(--e-4);
  }
  .heroe h1 {
    font-size: clamp(2.9rem, 1.4rem + 6vw, 6.6rem);
    font-weight: 350;
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin: 0 0 var(--e-4);
  }
  .heroe h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--tostado);
  }
  .heroe-pie {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--e-4);
    align-items: end;
    padding-top: var(--e-3);
    border-top: 1px solid var(--tinta);
  }
  .heroe .entradilla {
    margin: 0;
    max-width: 36rem;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    justify-self: end;
  }
  @media (max-width: 48rem) {
    .heroe {
      padding-top: var(--e-4);
    }
    .heroe-pie {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
    .acciones {
      justify-self: start;
    }
  }
  .heroe-imagen {
    margin-bottom: var(--e-4);
  }

  .datos {
    padding: var(--e-4) 0;
    border-block: 1px solid var(--linea);
  }
  .datos dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }
  .datos dl > div {
    padding: 0 var(--e-3);
    border-left: 1px solid var(--linea);
  }
  .datos dl > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .datos dt {
    font-family: var(--f-titulo);
    font-size: clamp(2.6rem, 1.8rem + 2.4vw, 3.8rem);
    font-weight: 300;
    line-height: 1;
    color: var(--tinta);
    letter-spacing: -0.03em;
    margin-bottom: var(--e-2);
  }
  .datos dd {
    margin: 0;
    color: var(--tinta-suave);
    font-size: var(--t-s);
    max-width: 18rem;
  }
  .datos dd strong {
    color: var(--tinta);
    font-weight: 600;
  }
  .datos-mas {
    margin: var(--e-4) 0 0;
  }
  @media (max-width: 48rem) {
    .datos dl {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
    .datos dl > div {
      padding: var(--e-3) 0 0;
      border-left: 0;
      border-top: 1px solid var(--linea);
    }
    .datos dl > div:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }

  .bloque {
    margin-top: var(--e-5);
  }
  .bloque-cabecera {
    margin-bottom: var(--e-3);
  }
  .bloque-cabecera h2 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.8rem);
    font-weight: 400;
  }
  .ver-todo {
    margin-top: var(--e-4);
  }
  .secciones {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--e-4);
  }
  @media (max-width: 48rem) {
    .secciones {
      grid-template-columns: 1fr;
    }
  }
  .secciones a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    grid-template-areas: 'num nombre' '. desc' '. cuenta';
    row-gap: 0.4rem;
    height: 100%;
    padding: var(--e-3) 0;
    border-top: 1px solid var(--linea);
    color: var(--tinta);
    text-decoration: none;
  }
  .secciones a:hover .nombre {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--galleta);
  }
  .num {
    grid-area: num;
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--tostado);
    padding-top: 0.35rem;
  }
  .nombre {
    grid-area: nombre;
    font-family: var(--f-titulo);
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .desc {
    grid-area: desc;
    font-size: var(--t-s);
    color: var(--tinta-suave);
    max-width: 30rem;
  }
  .cuenta {
    grid-area: cuenta;
    padding-top: var(--e-1);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .proyecto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--e-4);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--tinta);
    border-bottom: 1px solid var(--linea);
  }
  .proyecto h2 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 1.6vw, 2.8rem);
    font-weight: 400;
  }
  .proyecto-texto p {
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    font-weight: 350;
    line-height: 1.55;
    margin-bottom: var(--e-3);
  }
  @media (max-width: 48rem) {
    .proyecto {
      grid-template-columns: 1fr;
      gap: var(--e-2);
    }
  }
</style>
