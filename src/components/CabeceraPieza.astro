---
import CabeceraPagina from './CabeceraPagina.astro';
import PanelEditorial from './PanelEditorial.astro';
import { SECCIONES } from '../data/secciones';
import { ES_PRODUCCION, url, urlSeccion, esReceta, imagenPublicable, type Pieza } from '../lib/contenido';
import { fecha, fechaIso } from '../lib/formato';

interface Props {
  pieza: Pieza;
}
const { pieza } = Astro.props;
const { data } = pieza;
const seccion = SECCIONES[data.seccion];
// Minutos de lectura, calculados a partir del texto (unas 200 palabras por minuto).
const palabras = (pieza.body ?? '').replace(/<[^>]+>|[#*|>\-`\[\]()]/g, ' ').split(/\s+/).filter(Boolean).length;
const lectura = Math.max(1, Math.round(palabras / 200));
const actualizada =
  data.fechaActualizacion && data.fechaPublicacion && data.fechaActualizacion > data.fechaPublicacion
    ? data.fechaActualizacion
    : undefined;
// En producción, una foto provisional no se muestra: la cabecera queda solo con texto.
const imagen = imagenPublicable(data.imagen);
---

<CabeceraPagina
  migas={[{ nombre: seccion.nombre, href: urlSeccion(data.seccion) }, { nombre: data.titulo, href: url(pieza.id) }]}
  antetitulo={`${seccion.nombre}${esReceta(pieza) ? ' · Receta casera' : ''}`}
  titulo={data.titulo}
  entradilla={data.descripcion}
  imagen={imagen}
>
  <p class="firma">
    {
      data.fechaPublicacion ? (
        <span>
          Publicado el <time datetime={fechaIso(data.fechaPublicacion)}>{fecha(data.fechaPublicacion)}</time>
        </span>
      ) : (
        !ES_PRODUCCION && <span class="falta">Fecha de publicación: pendiente</span>
      )
    }
    {!esReceta(pieza) && <span>{lectura} min de lectura</span>}
    {
      actualizada && (
        <span>
          Actualizado el <time datetime={fechaIso(actualizada)}>{fecha(actualizada)}</time>
        </span>
      )
    }
  </p>
  <PanelEditorial estado={data.estado} pendientes={data.pendientes} intencion={data.intencion} />
</CabeceraPagina>

<style>
  .firma {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin: var(--e-3) 0 0;
    padding-top: var(--e-2);
    border-top: 1px solid color-mix(in srgb, var(--tinta) 25%, transparent);
  }
  .falta {
    color: var(--aviso);
    font-weight: 600;
  }
</style>
