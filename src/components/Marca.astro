---
// Símbolo del portal: un sello de línea fina con las iniciales. Hereda el color del texto.
const { tam = 34 } = Astro.props as { tam?: number };
---

<svg width={tam} height={tam} viewBox="0 0 64 64" aria-hidden="true" focusable="false" class="marca">
  <circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
  <circle cx="32" cy="32" r="25.5" fill="none" stroke="currentColor" stroke-width="0.75"></circle>
  <text x="32" y="40.5" text-anchor="middle" font-family="'Newsreader Variable', Georgia, serif" font-size="23" font-style="italic" fill="currentColor">GN</text>
</svg>
