---
import Base from '../layouts/Base.astro';
import CabeceraPieza from './CabeceraPieza.astro';
import Indice from './Indice.astro';
import Columnas from './Columnas.astro';
import Fuentes from './Fuentes.astro';
import Relacionados from './Relacionados.astro';
import { esAprobado, htmlPublicable, imagenPublicable, type Articulo } from '../lib/contenido';
import { esquemaPieza } from '../lib/esquemas';

interface Props {
  pieza: Articulo;
}
const { pieza } = Astro.props;
const { html, titulos: headings } = await htmlPublicable(pieza);
const esquemas = await esquemaPieza(pieza, Astro.site!, Astro.url.pathname);
---

<Base
  titulo={pieza.data.titulo}
  descripcion={pieza.data.descripcion}
  imagen={imagenPublicable(pieza.data.imagen)?.src}
  imagenAlt={imagenPublicable(pieza.data.imagen)?.alt}
  tipo="article"
  indexable={esAprobado(pieza)}
  esquemas={esquemas}
>
  <article>
    <CabeceraPieza pieza={pieza} />
    <Columnas>
      <div class="prosa">
        <Fragment set:html={html} />
        <Fuentes pieza={pieza} />
      </div>
      {headings.filter((t) => t.depth === 2).length >= 2 && <Indice titulos={headings} slot="lateral" />}
    </Columnas>
  </article>
  <Relacionados pieza={pieza} />
</Base>

<style>
  /* Letra capital al empezar el texto. */
  .prosa :global(> p:first-child::first-letter) {
    float: left;
    font-family: var(--f-titulo);
    font-size: 3.9em;
    line-height: 0.82;
    font-weight: 400;
    padding: 0.08em 0.1em 0 0;
    color: var(--tostado);
  }
</style>
