---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CabeceraPieza from './CabeceraPieza.astro';
import Indice from './Indice.astro';
import Fuentes from './Fuentes.astro';
import Relacionados from './Relacionados.astro';
import { esAprobado, type Articulo } from '../lib/contenido';
import { esquemaPieza } from '../lib/esquemas';

interface Props {
  pieza: Articulo;
}
const { pieza } = Astro.props;
const { Content, headings } = await render(pieza);
const esquemas = await esquemaPieza(pieza, Astro.site!, Astro.url.pathname);
---

<Base
  titulo={pieza.data.titulo}
  descripcion={pieza.data.descripcion}
  imagen={pieza.data.imagen.src}
  imagenAlt={pieza.data.imagen.alt}
  tipo="article"
  indexable={esAprobado(pieza)}
  esquemas={esquemas}
>
  <article>
    <CabeceraPieza pieza={pieza} />
    <div class="envoltorio cuerpo">
      <aside class="lateral"><Indice titulos={headings} /></aside>
      <div class="prosa">
        <Content />
        <Fuentes pieza={pieza} />
      </div>
    </div>
  </article>
  <Relacionados pieza={pieza} />
</Base>

<style>
  .cuerpo {
    display: grid;
    gap: var(--e-4);
    grid-template-columns: minmax(0, var(--ancho-texto)) 16rem;
    justify-content: space-between;
    margin-top: var(--e-4);
  }
  .lateral {
    order: 2;
  }
  .lateral :global(.indice) {
    position: sticky;
    top: var(--e-3);
  }
  @media (max-width: 62rem) {
    .cuerpo {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-3);
    }
    .lateral {
      order: 0;
    }
  }
</style>
