---
import Tarjeta from './Tarjeta.astro';
import type { Pieza } from '../lib/contenido';

interface Props {
  piezas: Pieza[];
  nivel?: 'h2' | 'h3';
}
const { piezas, nivel } = Astro.props;
---

<div class="rejilla">
  {piezas.map((p) => <Tarjeta pieza={p} nivel={nivel} />)}
</div>

<style>
  .rejilla {
    display: grid;
    gap: var(--e-4) var(--e-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }
</style>
