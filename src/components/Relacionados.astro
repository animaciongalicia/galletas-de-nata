---
import Rejilla from './Rejilla.astro';
import { getRelacionadas, type Pieza } from '../lib/contenido';

interface Props {
  pieza: Pieza;
}
const relacionadas = await getRelacionadas(Astro.props.pieza);
---

{
  relacionadas.length > 0 && (
    <section class="envoltorio relacionados" aria-labelledby="rel-titulo">
      <h2 id="rel-titulo">Sigue leyendo</h2>
      <Rejilla piezas={relacionadas} />
    </section>
  )
}

<style>
  .relacionados {
    margin-top: var(--e-5);
    padding-top: var(--e-4);
    border-top: 1px solid var(--linea);
  }
  h2 {
    margin-top: 0;
  }
</style>
