---
/**
 * Cabecera común de las páginas de lectura (secciones, historias, páginas, buscar, 404):
 * banda crema a todo el ancho, contenido en el marco de 72rem y foto opcional contenida a la derecha.
 */
import type { ImageMetadata } from 'astro';
import Migas from './Migas.astro';
import Figura from './Figura.astro';
import { tipografia } from '../lib/formato';

interface Props {
  migas?: { nombre: string; href: string }[];
  antetitulo?: string;
  titulo: string;
  /** Parte final del título en cursiva (opcional). */
  cursiva?: string;
  entradilla?: string;
  imagen?: { src: ImageMetadata; alt: string; provisional: boolean };
}
const { migas, antetitulo, titulo, cursiva, entradilla, imagen } = Astro.props;
---

<header class="cabecera-pagina banda banda--crema">
  <div class="envoltorio">
    {migas && <Migas items={migas} />}
    <div class:list={['rejilla', { 'con-foto': imagen }]}>
      <div>
        {antetitulo && <p class="antetitulo">{antetitulo}</p>}
        <h1>{titulo}{cursiva && <> <em>{cursiva}</em></>}</h1>
        {entradilla && <p class="entradilla">{tipografia(entradilla)}</p>}
        <slot />
      </div>
      {imagen && <Figura imagen={imagen} prioridad proporcion="4 / 3" tamanos="(max-width: 48rem) 100vw, 26rem" anchos={[400, 640, 800]} />}
    </div>
  </div>
</header>

<style>
  .cabecera-pagina {
    display: flow-root; /* evita que el margen de las migas se salga de la banda */
    padding-bottom: var(--e-5);
    margin-bottom: var(--e-5);
  }
  .rejilla {
    margin-top: var(--e-3);
  }
  .rejilla.con-foto {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 26rem;
    justify-content: space-between;
    gap: var(--e-4);
    align-items: end;
  }
  h1 {
    font-size: clamp(2.2rem, 1.3rem + 3vw, 3.8rem);
    font-weight: 350;
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--tostado);
  }
  .entradilla {
    margin-bottom: 0;
    max-width: 40rem;
  }
  @media (max-width: 48rem) {
    .rejilla.con-foto {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
    .rejilla.con-foto :global(.figura) {
      max-width: 22rem;
    }
  }
</style>
