---
import Base from '../layouts/Base.astro';
import CabeceraPagina from './CabeceraPagina.astro';
import Rejilla from './Rejilla.astro';
import Vacio from './Vacio.astro';
import Fuentes from './Fuentes.astro';
import HistoriasCasa from './HistoriasCasa.astro';
import Columnas from './Columnas.astro';
import type { Seccion } from '../data/secciones';
import { getPiezas, esAprobado, getTextoSeccion, htmlPublicable, url } from '../lib/contenido';
import { tipografia } from '../lib/formato';

interface Props {
  seccion: Seccion;
}
const { seccion } = Astro.props;
const piezas = await getPiezas(seccion.id);
const texto = await getTextoSeccion(seccion.id);
const historia = texto ? await htmlPublicable(texto) : undefined;
// Con historia propia, la sección tiene contenido aunque aún no haya piezas publicadas.
const indexable = Boolean(texto) || piezas.some(esAprobado);
const titular = texto?.data.titular ?? seccion.nombre;
const entradilla = texto?.data.entradilla ?? seccion.descripcion;
// Si la cita tiene una parte tras los dos puntos, esa parte va en cursiva.
const [citaA, citaB] = (texto?.data.cita ?? '').split(/:\s/);
---

<Base titulo={seccion.tituloSeo} descripcion={seccion.descripcion} indexable={indexable} imagen={texto?.data.imagen?.src} imagenAlt={texto?.data.imagen?.alt}>
  <CabeceraPagina
    migas={[{ nombre: seccion.nombre, href: `/${seccion.slug}/` }]}
    antetitulo={seccion.nombre}
    titulo={titular}
    entradilla={entradilla}
    imagen={texto?.data.imagen}
  />

  {
    historia && (
      <Columnas>
        <div class="prosa historia">
          <Fragment set:html={historia.html} />
        </div>
        <Fragment slot="lateral">
          {piezas.length > 0 && (
            <nav class="caja" aria-labelledby="lista-titulo">
              <p id="lista-titulo" class="antetitulo">En esta sección</p>
              <ol>
                {piezas.map((p) => (
                  <li><a href={url(p.id)}>{p.data.titulo}</a></li>
                ))}
              </ol>
            </nav>
          )}
          <div class="caja caja--verde">
            <p class="antetitulo">Historias de casa</p>
            <p>¿Cómo se hacían en tu casa? Cuéntalo y forma parte de esta historia.</p>
            <a class="enlace-flecha" href="/historias-de-casa/">Cuéntala →</a>
          </div>
        </Fragment>
      </Columnas>
    )
  }

  {
    texto?.data.cita && (
      <section class="envoltorio banda banda--tinta cita-banda" aria-label="Cita">
        <p class="cita">
          «{citaB ? <>{citaA}: <em>{citaB}</em></> : citaA}»
        </p>
      </section>
    )
  }

  <section class="envoltorio piezas" aria-labelledby="piezas-titulo">
    <p class="antetitulo">Para leer</p>
    <h2 id="piezas-titulo">En esta sección</h2>
    {piezas.length > 0 ? <Rejilla piezas={piezas} nivel="h3" /> : <Vacio mensaje={seccion.vacio} excluir={seccion.id} />}
    {texto && texto.data.fuentes.length > 0 && <div class="fuentes-seccion"><Fuentes lista={texto.data.fuentes} /></div>}
  </section>

  <HistoriasCasa />
</Base>

<style>
  .caja {
    padding: var(--e-3);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-top: 2px solid var(--tinta);
    font-size: var(--t-s);
  }
  .caja ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .caja li a {
    color: var(--tinta);
    text-decoration: none;
    font-family: var(--f-titulo);
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .caja li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--galleta);
  }
  .caja--verde {
    background: var(--oliva);
    border-color: var(--oliva);
    border-top-color: var(--galleta-claro);
    color: var(--marfil);
  }
  .caja--verde .antetitulo {
    color: var(--galleta-claro);
  }
  .caja--verde p:not(.antetitulo) {
    font-family: var(--f-titulo);
    font-size: 1.15rem;
    line-height: 1.45;
  }
  .caja--verde .enlace-flecha {
    color: var(--marfil);
    border-color: var(--marfil);
  }
  /* Letra capital en el primer párrafo de la historia. */
  .historia :global(> p:first-child::first-letter) {
    float: left;
    font-family: var(--f-titulo);
    font-size: 4.4em;
    line-height: 0.82;
    font-weight: 400;
    padding: 0.08em 0.1em 0 0;
    color: var(--tostado);
  }
  .cita-banda {
    padding-block: var(--e-5);
  }
  .cita {
    font-family: var(--f-titulo);
    font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.2rem);
    font-weight: 300;
    line-height: 1.15;
    max-width: 26ch;
    margin: 0 auto;
    text-align: center;
  }
  .cita em {
    color: var(--galleta-claro);
  }
  .piezas {
    padding-block: var(--e-5);
  }
  .piezas h2 {
    margin: 0 0 var(--e-4);
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: 400;
  }
  .fuentes-seccion {
    max-width: var(--ancho-texto);
  }
</style>
