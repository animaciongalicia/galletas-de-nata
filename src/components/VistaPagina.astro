---
import Base from '../layouts/Base.astro';
import CabeceraPagina from './CabeceraPagina.astro';
import PanelEditorial from './PanelEditorial.astro';
import { esAprobado, htmlPublicable, type Pagina } from '../lib/contenido';
import { fecha, fechaIso } from '../lib/formato';

interface Props {
  pagina: Pagina;
}
const { pagina } = Astro.props;
const { data } = pagina;
const { html } = await htmlPublicable(pagina);
---

<Base titulo={data.titulo} descripcion={data.descripcion} indexable={esAprobado(pagina)}>
  <CabeceraPagina migas={[{ nombre: data.titulo, href: `/${pagina.id}/` }]} titulo={data.titulo} entradilla={data.descripcion}>
    <PanelEditorial estado={data.estado} pendientes={data.pendientes} />
  </CabeceraPagina>
  <div class="ancho-pieza">
    <div class="prosa texto">
      <Fragment set:html={html} />
    </div>
    {
      data.fechaActualizacion && (
        <p class="actualizado">
          Última actualización: <time datetime={fechaIso(data.fechaActualizacion)}>{fecha(data.fechaActualizacion)}</time>
        </p>
      )
    }
  </div>
</Base>

<style>
  .texto {
    max-width: var(--ancho-texto);
  }
  .actualizado {
    margin-top: var(--e-4);
    font-size: var(--t-s);
    color: var(--tinta-suave);
  }
</style>
