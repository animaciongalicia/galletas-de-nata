---
/**
 * Ilustración de marca: galletas dibujadas sobre un fondo de color.
 * Se usa cuando un contenido aún no tiene fotografía propia. Es un dibujo
 * decorativo (aria-hidden), nunca se presenta como una foto.
 */
interface Props {
  /** Semilla: el mismo texto produce siempre el mismo dibujo. */
  semilla: string;
  tono?: 'galleta' | 'oliva' | 'crema' | 'tostado';
  proporcion?: string;
  densidad?: number;
  clase?: string;
}
const { semilla, tono = 'galleta', proporcion = '3 / 2', densidad = 5, clase } = Astro.props;

let s = [...semilla].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 11);
const azar = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32);

const [w, h] = proporcion.split('/').map((n) => Number(n.trim()) * 100);
const galletas = Array.from({ length: densidad }, (_, i) => {
  const r = (0.16 + azar() * 0.14) * Math.min(w, h);
  return {
    x: ((i + 0.5) / densidad) * w + (azar() - 0.5) * w * 0.12,
    y: h * (0.3 + azar() * 0.5),
    r,
    giro: Math.round(azar() * 360),
    capa: azar() > 0.5,
  };
});
// Galleta del símbolo del portal (coordenadas 0-64, centro en 32,32).
const borde =
  'M32 3c3 0 4 3 7 3.6 3 .6 5.3-1.6 8-.2 2.6 1.4 2.4 4.6 4.6 6.6 2.2 2 5.4 1.6 6.8 4.2 1.4 2.6-.8 5-.2 8 .6 3 3.6 4 3.6 7s-3 4-3.6 7c-.6 3 1.6 5.3.2 8-1.4 2.6-4.6 2.4-6.6 4.6-2 2.2-1.6 5.4-4.2 6.8-2.6 1.4-5-.8-8-.2-3 .6-4 3.6-7 3.6s-4-3-7-3.6c-3-.6-5.3 1.6-8 .2-2.6-1.4-2.4-4.6-4.6-6.6-2.2-2-5.4-1.6-6.8-4.2-1.4-2.6.8-5 .2-8C5.8 36 3 35 3 32s3-4 3.6-7c.6-3-1.6-5.3-.2-8 1.4-2.6 4.6-2.4 6.6-4.6 2-2.2 1.6-5.4 4.2-6.8 2.6-1.4 5 .8 8 .2C28 5.8 29 3 32 3Z';
---

<div class:list={['ilustracion', `ilustracion--${tono}`, clase]} style={`aspect-ratio: ${proporcion}`} aria-hidden="true">
  <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    {
      galletas.map((g) => (
        <g transform={`translate(${g.x} ${g.y}) rotate(${g.giro}) scale(${g.r / 29}) translate(-32 -32)`} class={g.capa ? 'g g--clara' : 'g'}>
          <path d={borde} class="masa" />
          <circle cx="32" cy="32" r="19" class="pespunte" />
          <circle cx="25" cy="26" r="1.8" class="punto" />
          <circle cx="39" cy="26" r="1.8" class="punto" />
          <circle cx="32" cy="32" r="1.8" class="punto" />
          <circle cx="25" cy="38" r="1.8" class="punto" />
          <circle cx="39" cy="38" r="1.8" class="punto" />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .ilustracion {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--fondo-ilus);
  }
  .ilustracion svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ilustracion--galleta {
    --fondo-ilus: #f1e2c4;
    --masa: #d6a05c;
    --masa-clara: #e6bf86;
  }
  .ilustracion--oliva {
    --fondo-ilus: #e3e6cf;
    --masa: #c99653;
    --masa-clara: #dfb77d;
  }
  .ilustracion--crema {
    --fondo-ilus: #f6eedd;
    --masa: #d9a868;
    --masa-clara: #ebcb98;
  }
  .ilustracion--tostado {
    --fondo-ilus: #ead6bb;
    --masa: #c4884a;
    --masa-clara: #d9a35e;
  }
  .masa {
    fill: var(--masa);
  }
  .g--clara .masa {
    fill: var(--masa-clara);
  }
  .pespunte {
    fill: none;
    stroke: #fff6e4;
    stroke-opacity: 0.6;
    stroke-width: 1.8;
    stroke-dasharray: 3 4;
  }
  .punto {
    fill: #9a6230;
    opacity: 0.75;
  }
</style>
