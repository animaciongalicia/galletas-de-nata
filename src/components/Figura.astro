---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ES_PRODUCCION } from '../lib/contenido';

interface Props {
  imagen: { src: ImageMetadata; alt: string; provisional: boolean; credito?: string };
  /** true en la imagen principal de la página (LCP): carga prioritaria. */
  prioridad?: boolean;
  anchos?: number[];
  tamanos?: string;
  proporcion?: string;
  clase?: string;
  pie?: boolean;
}

const {
  imagen,
  prioridad = false,
  anchos = [400, 640, 900, 1280, 1600],
  tamanos = '(max-width: 72rem) 100vw, 72rem',
  proporcion = '3 / 2',
  clase,
  pie = false,
} = Astro.props;
// Una imagen provisional nunca se publica. En producción no se muestra nada;
// en la previsualización queda un hueco discreto que recuerda que falta la foto.
const disponibles = [...new Set([...anchos.filter((w) => w < imagen.src.width), Math.min(imagen.src.width, Math.max(...anchos))])];
const ancho = Math.max(...disponibles);
const alto = Math.round((ancho * imagen.src.height) / imagen.src.width);
---

{imagen.provisional && !ES_PRODUCCION && (
  <div class:list={['figura', 'hueco', clase]} style={`aspect-ratio: ${proporcion}`}>
    <span>Foto pendiente</span>
  </div>
)}
{!imagen.provisional && (
<figure class:list={['figura', clase]} style={`--proporcion: ${proporcion}`}>
  <Image
    src={imagen.src}
    alt={imagen.alt}
    widths={disponibles}
    width={ancho}
    height={alto}
    sizes={tamanos}
    priority={prioridad}
    layout="none"
    format="webp"
  />
  {pie && imagen.credito && <figcaption>{imagen.credito}</figcaption>}
</figure>
)}

<style>
  .figura {
    position: relative;
    margin: 0;
  }
  .figura :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--proporcion);
    object-fit: cover;
    border-radius: var(--radio);
    background: var(--marfil-hondo);
  }
  .hueco {
    display: grid;
    place-items: center;
    max-height: 14rem;
    width: 100%;
    border: 1px dashed var(--linea);
    color: var(--tinta-suave);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  figcaption {
    font-size: var(--t-xs);
    color: var(--tinta-suave);
    margin-top: 0.5rem;
  }
</style>
