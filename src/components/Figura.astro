---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ES_PRODUCCION } from '../lib/contenido';
import Ilustracion from './Ilustracion.astro';

interface Props {
  imagen: { src: ImageMetadata; alt: string; provisional: boolean; credito?: string };
  /** true en la imagen principal de la página (LCP): carga prioritaria. */
  prioridad?: boolean;
  anchos?: number[];
  tamanos?: string;
  proporcion?: string;
  clase?: string;
  pie?: boolean;
  /** Para la ilustración que sustituye a la foto mientras no hay una propia. */
  semilla?: string;
  tono?: 'galleta' | 'oliva' | 'crema' | 'tostado';
  densidad?: number;
}

const {
  imagen,
  prioridad = false,
  anchos = [400, 640, 900, 1280, 1600],
  tamanos = '(max-width: 72rem) 100vw, 72rem',
  proporcion = '3 / 2',
  clase,
  pie = false,
  semilla = imagen.alt,
  tono = 'galleta',
  densidad,
} = Astro.props;
// Una imagen provisional nunca se muestra: en su lugar va una ilustración de marca.
const mostrar = !imagen.provisional;
const disponibles = anchos.filter((w) => w <= imagen.src.width);
const ancho = Math.max(...disponibles);
const alto = Math.round((ancho * imagen.src.height) / imagen.src.width);
---

{!mostrar && (
  <div class:list={['figura', clase]}>
    <Ilustracion semilla={semilla} tono={tono} proporcion={proporcion} densidad={densidad} />
    {!ES_PRODUCCION && <span class="sello">Foto pendiente</span>}
  </div>
)}
{mostrar && (
<figure class:list={['figura', clase]} style={`--proporcion: ${proporcion}`}>
  <Image
    src={imagen.src}
    alt={imagen.alt}
    widths={disponibles}
    width={ancho}
    height={alto}
    sizes={tamanos}
    priority={prioridad}
    layout="none"
    format="webp"
  />
  {imagen.provisional && <span class="sello">Imagen provisional</span>}
  {pie && imagen.credito && <figcaption>{imagen.credito}</figcaption>}
</figure>
)}

<style>
  .figura {
    position: relative;
    margin: 0;
  }
  .figura :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--proporcion);
    object-fit: cover;
    border-radius: var(--radio);
    background: var(--marfil-hondo);
  }
  .sello {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--aviso);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  figcaption {
    font-size: var(--t-xs);
    color: var(--tinta-suave);
    margin-top: 0.4rem;
  }
</style>
