---
import { LISTA_SECCIONES } from '../data/secciones';
import { SITIO } from '../data/sitio';
import { getPaginas } from '../lib/contenido';
import Marca from './Marca.astro';

const paginas = (await getPaginas()).filter((p) => p.data.enPie);
---

<footer class="pie">
  <div class="envoltorio rejilla">
    <div class="marca-pie">
      <p class="nombre"><Marca tam={28} /> {SITIO.nombre}</p>
      <p class="lema">La galleta de nata gallega: su historia, la nata que necesita y cómo volver a hacerla en casa.</p>
    </div>
    <nav aria-label="Secciones">
      <h2>Secciones</h2>
      <ul>
        {LISTA_SECCIONES.map((s) => <li><a href={`/${s.slug}/`}>{s.nombre}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Participa">
      <h2>Participa</h2>
      <ul>
        <li><a href="/historias-de-casa/">Historias de casa</a></li>
        <li><a href="/buscar/">Todos los contenidos</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        {SITIO.correoEditorial && <li><a href={`mailto:${SITIO.correoEditorial}`}>{SITIO.correoEditorial}</a></li>}
      </ul>
    </nav>
    <nav aria-label="La web">
      <h2>La web</h2>
      <ul>
        {paginas.map((p) => <li><a href={`/${p.id}/`}>{p.data.titulo}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="envoltorio legal">
    <p>Portal editorial independiente. No vende galletas ni representa a ninguna marca o fabricante.</p>
  </div>
</footer>

<style>
  .pie {
    margin-top: 0;
    background: var(--tinta);
    color: #eadfca;
    padding: var(--e-4) 0 var(--e-5);
    font-size: var(--t-s);
  }
  .rejilla {
    display: grid;
    gap: var(--e-4);
    grid-template-columns: 1.4fr repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 62rem) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-4) var(--e-3);
    }
    .marca-pie {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .rejilla {
      grid-template-columns: 1fr;
    }
  }
  .legal {
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1px solid rgb(234 223 202 / 18%);
    color: #bfb39c;
    font-size: var(--t-xs);
  }
  .legal p {
    margin: 0;
  }
  .nombre {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: var(--e-1);
  }
  .lema {
    max-width: 28rem;
  }
  h2 {
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--galleta-claro);
    margin: 0 0 var(--e-1);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin: 0.25rem 0;
  }
  a {
    color: #fff;
    display: inline-block;
    padding: 0.2rem 0;
  }
  a:hover {
    color: var(--galleta-claro);
  }
</style>
