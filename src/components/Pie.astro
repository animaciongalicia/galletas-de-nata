---
import { LISTA_SECCIONES } from '../data/secciones';
import { SITIO } from '../data/sitio';
import { getPaginas } from '../lib/contenido';
import Marca from './Marca.astro';

const paginas = (await getPaginas()).filter((p) => p.data.enPie);
---

<footer class="pie">
  <div class="envoltorio rejilla">
    <div>
      <p class="nombre"><Marca tam={28} /> {SITIO.nombre}</p>
      <p class="lema">{SITIO.lema}</p>
      <p class="independiente">
        Portal editorial independiente. No vende galletas ni representa a ninguna marca o fabricante.
      </p>
    </div>
    <nav aria-label="Secciones">
      <h2>Secciones</h2>
      <ul>
        {LISTA_SECCIONES.map((s) => <li><a href={`/${s.slug}/`}>{s.nombre}</a></li>)}
        <li><a href="/buscar/">Todos los contenidos</a></li>
      </ul>
    </nav>
    <nav aria-label="La web">
      <h2>La web</h2>
      <ul>
        <li><a href="/historias-de-casa/">Historias de casa</a></li>
        {paginas.map((p) => <li><a href={`/${p.id}/`}>{p.data.titulo}</a></li>)}
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .pie {
    margin-top: 0;
    background: var(--tinta);
    color: #eadfca;
    padding: var(--e-4) 0 var(--e-5);
    font-size: var(--t-s);
  }
  .rejilla {
    display: grid;
    gap: var(--e-4);
    grid-template-columns: 2fr 1fr 1fr;
  }
  @media (max-width: 48rem) {
    .rejilla {
      grid-template-columns: 1fr;
      gap: var(--e-3);
    }
  }
  .nombre {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--f-titulo);
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: var(--e-1);
  }
  .lema {
    max-width: 28rem;
  }
  .independiente {
    color: #bfb39c;
    font-size: var(--t-xs);
  }
  h2 {
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--galleta-claro);
    margin: 0 0 var(--e-1);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin: 0.25rem 0;
  }
  a {
    color: #fff;
    display: inline-block;
    padding: 0.2rem 0;
  }
  a:hover {
    color: var(--galleta-claro);
  }
</style>
