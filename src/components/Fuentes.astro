---
// Fuentes consultadas: solo el nombre y la nota, sin enlaces de salida.
// La URL se conserva en el contenido como registro interno, pero no se publica.
import type { Pieza } from '../lib/contenido';

interface Props {
  pieza: Pieza;
}
const { fuentes } = Astro.props.pieza.data;
---

{
  fuentes.length > 0 && (
    <aside class="fuentes" aria-labelledby="fuentes-titulo">
      <h2 id="fuentes-titulo">Fuentes consultadas</h2>
      <ol>
        {fuentes.map((f) => (
          <li>
            <span class="titulo">{f.titulo}</span>
            {f.nota && <span class="nota">{f.nota}</span>}
          </li>
        ))}
      </ol>
    </aside>
  )
}

<style>
  .fuentes {
    margin-top: var(--e-5);
    padding-top: var(--e-3);
    border-top: 1px solid var(--linea);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--tinta-suave);
  }
  :global(.prosa) .fuentes h2 {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }
  :global(.prosa) .fuentes h2::before {
    content: none;
  }
  h2 {
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oliva);
    margin: 0 0 var(--e-2);
  }
  ol {
    margin: 0;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.45rem;
  }
  li::marker {
    color: var(--galleta);
    font-weight: 700;
  }
  .titulo {
    color: var(--tinta);
  }
  .nota {
    display: block;
    color: var(--tinta-suave);
  }
</style>
