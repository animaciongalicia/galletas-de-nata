---
import { LISTA_SECCIONES } from '../data/secciones';
import Marca from './Marca.astro';

const enlaces = [
  ...LISTA_SECCIONES.map((s) => ({ href: `/${s.slug}/`, texto: s.nombre })),
  { href: '/diario/', texto: 'Diario' },
  { href: '/historias-de-casa/', texto: 'Historias de casa' },
];
const ruta = Astro.url.pathname;
const actual = (href: string) => (ruta.startsWith(href) ? 'page' : undefined);
---

<header class="cabecera">
  <div class="envoltorio barra">
    <a href="/" class="logo" aria-label="Galletas de Nata, ir a la portada">
      <Marca tam={38} />
      <span class="logo-texto">
        <span class="logo-nombre">Galletas de Nata</span>
        <span class="logo-lema">Galicia · tradición · nata</span>
      </span>
    </a>

    <!-- Escritorio -->
    <nav class="nav-ancha" aria-label="Principal">
      <ul>
        {enlaces.map((e) => <li><a href={e.href} aria-current={actual(e.href)}>{e.texto}</a></li>)}
        <li><a href="/buscar/" class="buscar" aria-current={actual('/buscar/')}>Buscar</a></li>
      </ul>
    </nav>

    <!-- Móvil: <details> funciona con teclado y lector de pantalla, sin JavaScript. -->
    <details class="nav-movil">
      <summary>Menú</summary>
      <nav aria-label="Principal">
        <ul>
          {enlaces.map((e) => <li><a href={e.href} aria-current={actual(e.href)}>{e.texto}</a></li>)}
          <li><a href="/buscar/" aria-current={actual('/buscar/')}>Buscar</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .cabecera {
    border-bottom: 1px solid var(--linea);
    background: var(--marfil);
  }
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2);
    min-height: 5rem;
    position: relative;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--tinta);
    text-decoration: none;
  }
  .logo-texto {
    display: grid;
    line-height: 1.1;
  }
  .logo-nombre {
    font-family: var(--f-titulo);
    font-weight: 450;
    font-size: 1.4rem;
    letter-spacing: -0.005em;
  }
  .logo-lema {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-top: 0.2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-ancha ul {
    display: flex;
    gap: 0.25rem;
  }
  .nav-ancha a,
  .nav-movil a {
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--tinta);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .nav-ancha a:hover,
  .nav-movil a:hover {
    color: var(--oliva);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }
  .buscar {
    border-left: 1px solid var(--linea);
    margin-left: 0.4rem;
    padding-left: 1rem !important;
  }

  .nav-movil {
    display: none;
  }
  summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1rem;
    border: 1px solid var(--tinta);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .nav-movil[open] summary {
    background: var(--tinta);
    color: #fff;
  }
  .nav-movil nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 5;
    background: var(--papel);
    border: 1px solid var(--linea);
    box-shadow: var(--sombra);
    padding: var(--e-1);
  }
  .nav-movil a {
    padding: 0.85rem 1rem;
    font-size: var(--t-m);
  }

  @media (max-width: 62rem) {
    .nav-ancha {
      display: none;
    }
    .nav-movil {
      display: block;
    }
  }
</style>
