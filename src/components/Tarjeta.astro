---
import Figura from './Figura.astro';
import Estado from './Estado.astro';
import { SECCIONES } from '../data/secciones';
import { url, esReceta, type Pieza } from '../lib/contenido';
import { duracion, tipografia } from '../lib/formato';

interface Props {
  pieza: Pieza;
  nivel?: 'h2' | 'h3';
}
const { pieza, nivel = 'h3' } = Astro.props;
const { data } = pieza;
const Titulo = nivel;
const total = esReceta(pieza) ? pieza.data.tiempos.total : undefined;
---

<article class="tarjeta" data-seccion={data.seccion} data-titulo={data.titulo.toLowerCase()}>
  {data.imagen.provisional ? (
    <div class="sin-foto" aria-hidden="true">
      <span>{SECCIONES[data.seccion].corto}</span>
    </div>
  ) : (
  <Figura imagen={data.imagen} proporcion="3 / 2" anchos={[400, 640, 800]} tamanos="(max-width: 40rem) 100vw, (max-width: 72rem) 50vw, 23rem" />
  )}
  <div class="cuerpo">
    <p class="antetitulo">
      {SECCIONES[data.seccion].corto}{esReceta(pieza) && ' · Receta'}{total && ` · ${duracion(total)}`}
    </p>
    <Titulo class="titulo"><a href={url(pieza.id)}>{data.titulo}</a></Titulo>
    <p class="descripcion">{tipografia(data.descripcion)}</p>
    <Estado estado={data.estado} />
  </div>
</article>

<style>
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding-top: var(--e-2);
    border-top: 1px solid var(--tinta);
  }
  /* Sin foto todavía: un panel tipográfico del mismo tamaño, nunca un falso retrato. */
  .sin-foto {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
    background: var(--marfil-hondo);
    border: 1px solid color-mix(in srgb, var(--tinta) 10%, transparent);
  }
  .sin-foto span {
    font-family: var(--f-titulo);
    font-style: italic;
    font-weight: 300;
    font-size: 1.9rem;
    color: var(--tostado);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--galleta);
  }
  :global(.banda--crema) .sin-foto {
    background: var(--papel);
  }
  .cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .antetitulo {
    font-size: 0.68rem;
    margin-bottom: var(--e-1);
  }
  .titulo {
    font-size: 1.45rem;
    font-weight: 450;
    line-height: 1.2;
    margin: 0 0 0.6rem;
  }
  .titulo a {
    color: var(--tinta);
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable, con un único enlace accesible. */
  .titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .titulo a:focus-visible {
    outline: none;
  }
  .tarjeta:has(a:focus-visible) {
    outline: 2px solid var(--oliva);
    outline-offset: 6px;
  }
  .tarjeta:hover .titulo a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--galleta);
  }
  .descripcion {
    color: var(--tinta-suave);
    font-size: var(--t-s);
    line-height: 1.6;
    margin: 0;
  }
</style>
