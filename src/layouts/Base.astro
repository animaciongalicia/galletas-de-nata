---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITIO } from '../data/sitio';
import { ES_PRODUCCION } from '../lib/contenido';
import imagenPorDefecto from '../assets/marca/og-galletas-de-nata.jpg';
// Precarga de las fuentes (subconjunto latino) para evitar saltos de diseño al cargar.
import fuenteTitulo from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';

interface Props {
  /** Título de la página, sin el nombre del sitio. */
  titulo: string;
  descripcion: string;
  imagen?: ImageMetadata;
  imagenAlt?: string;
  tipo?: 'website' | 'article';
  /** false = noindex (borradores, estados vacíos, búsqueda). */
  indexable?: boolean;
  /** Bloques JSON-LD adicionales. */
  esquemas?: object[];
  /** Título completo sin sufijo (portada). */
  tituloCompleto?: boolean;
}

const {
  titulo,
  descripcion,
  imagen = imagenPorDefecto,
  imagenAlt = SITIO.nombre,
  tipo = 'website',
  indexable = true,
  esquemas = [],
  tituloCompleto = false,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const tituloFinal = tituloCompleto ? titulo : `${titulo} | ${SITIO.nombre}`;
const og = await getImage({ src: imagen, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;
// La preview nunca se indexa. En producción, solo las páginas indexables.
const robots = ES_PRODUCCION && indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';
const verificacionGoogle = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fuenteTitulo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <title>{tituloFinal}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.nombre} href="/rss.xml" />
    <meta name="theme-color" content="#f8f3e8" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content={SITIO.locale} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {verificacionGoogle && <meta name="google-site-verification" content={verificacionGoogle} />}
    {esquemas.map((e) => <JsonLd datos={e} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {
      !ES_PRODUCCION && (
        <div class="aviso-preview" role="note">
          <strong>Vista previa editorial.</strong> No indexable. Incluye borradores e imágenes provisionales
          marcados como tales.
        </div>
      )
    }
    <Cabecera />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
  </body>
</html>

<style>
  .aviso-preview {
    background: var(--aviso-fondo);
    color: var(--aviso);
    border-bottom: 1px solid #e8c9a8;
    padding: 0.5rem var(--e-2);
    font-size: var(--t-xs);
    text-align: center;
  }
  main:focus {
    outline: none;
  }
</style>
